# Copy to .env. Use a unique password of at least 12 characters.
ADMIN_PASSWORD=CHANGE_ME_Use_A_Unique_Password
HOST_PORT=8088
# Public online image; pin a version or sha-<commit> tag to roll back.
HARBOR_IMAGE=ghcr.io/herowoo/c11-harbor:latest
POLL_MINUTES=5
# Enable only when ready to test real AC commands; UI confirmation is also required.
ALLOW_CONTROL=false
# Optional: use your existing Amap Web Service key for address text.
AMAP_WEB_KEY=
# HTTPS origin of a NAS reverse proxy with a trusted certificate; no path.
PAIR_BASE_URL=
